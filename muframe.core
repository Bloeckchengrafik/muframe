CAPI=2: {}

name: :bloeckchengrafik:muframe:0.1
description: Muframe - Mainframe on a Chip

filesets:
  rtl:
    files:
      - rtl/muf_top.sv
      - rtl/cpu/bus/wb.sv
      - rtl/cpu/bus/instr_fifo.sv
      - rtl/cpu/bus/instr_mem_host.sv
      - rtl/cpu/muframe.sv
    file_type: systemVerilogSource
    depend:
      - "award-winning:wishbone:wb_intercon:1.4.2"
      - "award-winning:wishbone:wb_ram:1.1.0"

  tb:
    files:
      - tb/muf_tb.sv
      - tb/instr_mem_host_tb.sv
      - tb/instr_fifo_tb.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - rtl
    toplevel: muf_top
    generate:
      - wb_intercon

  sim: &sim
    <<: *default
    description: Simulate the design
    default_tool: icarus
    filesets_append:
      - tb
    toplevel: muf_tb
    tools:
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012
      modelsim:
        vlog_options:
          - -timescale=1ns/1ns

  test_instr_mem_host:
    <<: *sim
    description: Test the instr_mem_host module
    toplevel: instr_mem_host_tb


  test_instr_fifo:
    <<: *sim
    description: Test the instr_fifo module
    toplevel: instr_fifo_tb


generate:
  wb_intercon:
    generator: wb_intercon_gen
    parameters:
      endian: big
      hosts:
        muf_instr:
          devices: [mem]
        muf_data:
          devices: [mem]
      devices:
        mem:
          offset: 0x0
          size: 0x00008000
